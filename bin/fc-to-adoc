#!/usr/bin/env python3
"""Render the S-411 feature catalogue (annex D) as AsciiDoc on stdout.

    bin/fc-to-adoc sources/1.1.0/PS/data/S411FC.xml > annex-d.adoc

Replaces the lutaml_data binding that failed on the released stack with an
xs:ID -> ID NameError (see bin/annex-d-lutaml-binding.txt for the binding
and the reason it is out of the build). Called by bin/assemble-ps.
"""
import sys
import xml.etree.ElementTree as ET

FC = "{http://www.iho.int/S100FC}"
HEADER = """// Generated by bin/fc-to-adoc from data/S411FC.xml (WMO S-411 2014 feature catalogue, v1.0.0).
// The lutaml_data binding it replaces is kept in bin/annex-d-lutaml-binding.txt.

[[annex-D]]
[appendix]
== Feature Catalogue
"""


def text(el, tag):
    return " ".join(el.find(FC + tag).text.split())


def main(path):
    root = ET.parse(path).getroot()
    simple = {a.find(FC + "code").text: (text(a, "name"), text(a, "definition"))
              for a in root.iter(FC + "simpleAttribute")}
    complex_ = {a.find(FC + "code").text: (text(a, "name"), text(a, "definition"))
                for a in root.iter(FC + "complexAttribute")}
    lines = [HEADER]
    for feature in root.iter(FC + "featureType"):
        lines += ["=== %s" % text(feature, "name"), "", text(feature, "definition"), ""]
        for binding in feature.iter(FC + "attributeBinding"):
            code = binding.find(FC + "attribute").get("ref")
            name, definition = simple.get(code) or complex_[code]
            lines.append("* *%s* (%s): %s" % (name, code, definition))
        lines.append("")
    sys.stdout.write("\n".join(lines).rstrip("\n") + "\n")


if __name__ == "__main__":
    main(sys.argv[1])
