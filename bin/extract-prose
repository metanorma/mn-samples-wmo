#!/usr/bin/env python3
"""Extract the S-411 prose from the reference PDF into build/intermediate.json.

Step 1 of metanorma/mn-samples-wmo#3 (pdf -> intermediate -> adoc).

    bin/extract-prose [PDF] [BUILD_DIR]

Needs poppler-utils (pdftotext, pdfimages) on PATH; no Python dependencies.
Deterministic: output depends only on the PDF bytes and the poppler version.
Writes BUILD_DIR/intermediate.json and BUILD_DIR/images/*.png.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import unicodedata

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DEFAULT_PDF = os.path.join(ROOT, "reference-docs", "S-411_Specification_1_1_0_June2014.pdf")
DEFAULT_BUILD = os.path.join(ROOT, "build")

FOOTER_RE = re.compile(r"^\s*(Edition 1\.1\.0\s+June 2014\s+S-411|S-411\s+June 2014\s+Edition 1\.1\.0)\s*$")
HEADER_RE = re.compile(r"^\s*Ice Information Product Specification\s*$")
PAGENUM_RE = re.compile(r"^\s{20,}(\d+|[ivx]+)\s*$")
HEADING_RE = re.compile(r"^(\d+(?:\.\d+)*)\s+([A-Za-z]\S*(?: \S+)*)$")
ANNEX_RE = re.compile(r"^Annex ([A-Z]) [–-] (\S.*)$")
FIGURE_RE = re.compile(r"^\s*Figure (\d+):\s*(.+?)\s*$")
TABLE_RE = re.compile(r"^\s*Table (\d+):\s*(.+?)\s*$")
CELL_SPLIT = re.compile(r"\s{3,}")
SENTENCE_END = tuple('.:;)?!"”')


def run(cmd):
    try:
        return subprocess.run(cmd, check=True, stdout=subprocess.PIPE).stdout
    except FileNotFoundError:
        raise SystemExit("extract-prose: %s not found on PATH (install poppler-utils)" % cmd[0])
    except subprocess.CalledProcessError as e:
        raise SystemExit("extract-prose: %s exited %d (unreadable or malformed PDF?)" % (cmd[0], e.returncode))


def cells_of(line):
    """Return [(start, text)] for cells separated by 3+ spaces."""
    out = []
    pos = 0
    stripped = line.rstrip()
    for m in re.finditer(r"\S+(?: {1,2}\S+)*", stripped):
        out.append((m.start(), m.group(0)))
    merged = []
    for start, text in out:
        if merged and start - (merged[-1][0] + len(merged[-1][1])) < 3:
            merged[-1] = (merged[-1][0], merged[-1][1] + " " + text)
        else:
            merged.append((start, text))
    return merged


def is_bullet(line):
    s = line.lstrip()
    return bool(s) and (unicodedata.category(s[0]) in ("Co", "So") or s[0] in "•·") \
        and len(s) > 1 and s[1] in " \t"


def looks_code(line):
    return line.lstrip().startswith("<")


def read_pages(pdf):
    text = run(["pdftotext", "-layout", "-enc", "UTF-8", pdf, "-"]).decode("utf-8")
    pages = text.split("\f")
    if pages and not pages[-1].strip():
        pages.pop()
    return pages


def clean(page_text):
    lines = []
    for ln in page_text.split("\n"):
        ln = ln.rstrip().replace("\t", "    ")
        if FOOTER_RE.match(ln) or HEADER_RE.match(ln) or PAGENUM_RE.match(ln):
            continue
        lines.append(ln)
    return lines


def parse_front(pages):
    """Title page metadata and the version-history table (pages before the TOC)."""
    cover = [l.strip() for l in pages[0].split("\n") if l.strip()]
    meta = {"cover_lines": cover}
    for l in cover:
        m = re.match(r"^Edition (\S+), (\w+) (\d{4})$", l)
        if m:
            meta.update(edition=m.group(1), month=m.group(2), year=m.group(3))
        m = re.match(r"^Special Publication (\S+) (\S+)$", l)
        if m:
            meta.update(committee=m.group(1), designation=m.group(2))
    meta["title"] = cover[2] if len(cover) > 2 else ""
    meta["organization"] = cover[0].title() if cover else ""
    meta["publisher"] = " ".join(cover[cover.index("Published by the") + 1:cover.index("Published by the") + 3]) \
        if "Published by the" in cover else ""
    meta["publisher_address"] = [l for l in cover[cover.index("Published by the") + 3:]] \
        if "Published by the" in cover else []
    # version history: rows anchored on a version number, continuation lines
    # attach to the nearest anchor line.
    vh = []
    for ln in pages[1].split("\n"):
        if re.match(r"^\s*Contents\s*$", ln):
            break
        vh.append(ln)
    start = next((i for i, l in enumerate(vh) if l.startswith("Version Number")), None)
    version = None
    if start is not None:
        head = [t for _, t in cells_of(vh[start])]
        starts = [s for s, _ in cells_of(vh[start])]
        raw = list(enumerate(vh[start + 1:], start + 1))
        anchors = [i for i, l in raw if re.match(r"^\d+\.\d+\.\d+\s", l)]
        rows = {a: [""] * len(head) for a in anchors}

        def put(a, l):
            for s, t in cells_of(l):
                col = max(c for c in range(len(starts)) if starts[c] <= s + 2)
                rows[a][col] = (rows[a][col] + " " + t).strip()

        # Continuation runs (no blank line inside) belong to the anchor they
        # touch: the one below if the run touches it, else the one above.
        k = 0
        while k < len(raw):
            i, l = raw[k]
            if not l.strip():
                k += 1
                continue
            if i in anchors:
                put(i, l)
                k += 1
                continue
            run = []
            while k < len(raw) and raw[k][1].strip() and raw[k][0] not in anchors:
                run.append(raw[k][1])
                k += 1
            below = raw[k][0] if k < len(raw) and raw[k][0] in anchors else None
            above = max([a for a in anchors if a < i], default=None)
            touches_above = above is not None and not any(
                not raw[j - start - 1][1].strip() for j in range(above + 1, i))
            target = above if touches_above or below is None else below
            for r in run:
                put(target, r)
        version = {"header": head, "rows": [rows[a] for a in anchors]}
    meta["version_history"] = version
    return meta


def body_start(pages):
    for i, p in enumerate(pages):
        for ln in p.split("\n"):
            if re.match(r"^1\s+Overview\s*$", ln):
                return i
    raise SystemExit("body start not found")


def parse_blocks(pages, first):
    """Walk the cleaned line stream and emit flat blocks."""
    stream = []  # (page, text)
    for pi in range(first, len(pages)):
        for ln in clean(pages[pi]):
            stream.append((pi + 1, ln))
    blocks = []
    i = 0
    n = len(stream)
    pending_table_title = None

    def peek_nonblank(j):
        while j < n and not stream[j][1].strip():
            j += 1
        return j

    while i < n:
        page, ln = stream[i]
        if not ln.strip():
            i += 1
            continue
        m = ANNEX_RE.match(ln.strip()) if ln == ln.lstrip() else None
        if m:
            blocks.append({"type": "heading", "page": page, "level": 1, "number": "Annex " + m.group(1),
                           "annex": m.group(1), "title": m.group(2).strip()})
            i += 1
            continue
        m = HEADING_RE.match(ln) if ln == ln.lstrip() else None
        if m and not looks_code(ln):
            num = m.group(1)
            blocks.append({"type": "heading", "page": page, "level": num.count(".") + 1,
                           "number": num, "title": m.group(2).strip()})
            i += 1
            continue
        m = FIGURE_RE.match(ln)
        if m:
            blocks.append({"type": "figure", "page": page, "number": int(m.group(1)),
                           "caption": m.group(2)})
            i += 1
            continue
        m = TABLE_RE.match(ln)
        if m:
            pending_table_title = m.group(2)
            i += 1
            continue
        if looks_code(ln):
            code = []
            while i < n:
                p2, l2 = stream[i]
                if l2.strip():
                    if code and l2 == l2.lstrip() and not looks_code(l2) \
                            and (HEADING_RE.match(l2) or len(cells_of(l2)) >= 2):
                        break  # a heading or table row directly after the code
                    code.append(l2)
                    i += 1
                    continue
                j = peek_nonblank(i)
                if j < n and (looks_code(stream[j][1]) or stream[j][1].startswith("   ")
                              or stream[j][1].strip() == ".") and not HEADING_RE.match(stream[j][1]) \
                        and not is_bullet(stream[j][1]) and len(cells_of(stream[j][1])) < 2:
                    crosses_page = stream[j][0] != stream[i - 1][0]
                    i = j
                    if not crosses_page and code and code[-1] != "":
                        code.append("")
                    continue
                break
            while code and not code[-1]:
                code.pop()
            ind = min(len(c) - len(c.lstrip()) for c in code if c.strip())
            blocks.append({"type": "code", "page": page, "lang": "xml",
                           "lines": [c[ind:] if c.strip() else "" for c in code]})
            continue
        if is_bullet(ln):
            items = []
            while i < n:
                p2, l2 = stream[i]
                if is_bullet(l2):
                    items.append(l2.lstrip()[1:].strip())
                    i += 1
                elif l2.strip() and items and l2.startswith(" ") and not looks_code(l2) \
                        and len(cells_of(l2)) < 2 and not HEADING_RE.match(l2):
                    items[-1] += " " + l2.strip()
                    i += 1
                else:
                    break
            blocks.append({"type": "list", "page": page, "items": items})
            continue
        cs = cells_of(ln)
        if len(cs) >= 2:
            tbl, i = parse_table(stream, i)
            tbl["page"] = page
            tbl["title"] = pending_table_title
            pending_table_title = None
            blocks.append(tbl)
            continue
        para = []
        while i < n:
            p2, l2 = stream[i]
            if not l2.strip() or (para and (HEADING_RE.match(l2) and l2 == l2.lstrip()
                                             or FIGURE_RE.match(l2) or TABLE_RE.match(l2)
                                             or looks_code(l2) or is_bullet(l2)
                                             or len(cells_of(l2)) >= 2)):
                break
            para.append(l2.strip())
            i += 1
        blocks.append({"type": "paragraph", "page": page, "text": join_lines(para)})
    return merge_split_paragraphs(blocks)


WRAP_MIN = 80  # a line shorter than this was not wrapped: keep the line break


def join_lines(lines):
    out = lines[0]
    prev = lines[0]
    for l in lines[1:]:
        last = out.split(" ")[-1]
        if len(prev) < WRAP_MIN:
            out += "\n" + l
        elif out.endswith("-") and len(last) <= 2:
            out += l
        else:
            out += " " + l
        prev = l
    return out


def merge_split_paragraphs(blocks):
    out = []
    for b in blocks:
        if out and b["type"] == "paragraph" and out[-1]["type"] == "paragraph" \
                and b["page"] != out[-1]["page"] and not out[-1]["text"].endswith(SENTENCE_END) \
                and b["text"][:1].islower():
            out[-1]["text"] += " " + b["text"]
        else:
            out.append(b)
    return out


def parse_table(stream, i):
    n = len(stream)
    first_page = stream[i][0]
    first = cells_of(stream[i][1])
    starts = [s for s, _ in first]
    header_cells = [t for _, t in first]
    kv = header_cells[0].endswith(":") or bool(re.match(r"^[A-Z0-9_]{2,}$", header_cells[0]))
    rows = []
    page_starts = {first_page: starts}  # column starts differ per page (Word autofit)
    ncols = [len(starts)]

    def col_of(st, s):
        c = [k for k in range(len(st)) if st[k] <= s + 2]
        return c[-1] if c else 0

    def place(cs, page):
        nonlocal starts
        if page not in page_starts and len(cs) >= len(starts):
            page_starts[page] = [s for s, _ in cs][:len(starts)]
        st = page_starts.get(page, starts)
        if kv:
            for s, _ in cs:
                if s > st[-1] + 2 and len(cs) > 1:
                    starts.append(s)
                    for r in rows:
                        r.append("")
                    for pg in page_starts:
                        if page_starts[pg] is not starts:
                            page_starts[pg] = page_starts[pg] + [s]
        row = [""] * len(starts)
        for s, t in cs:
            c = col_of(st, s)
            row[c] = (row[c] + " " + t).strip()
        return row

    rows.append(place(first, first_page))
    i += 1
    # header continuation: line right after with fewer cells than columns
    if i < n and stream[i][1].strip():
        cs = cells_of(stream[i][1])
        if 2 <= len(cs) < len(starts) and not kv and cs[0][0] <= starts[0] + 1:
            r = place(cs, stream[i][0])
            rows[0] = [(a + " " + b).strip() for a, b in zip(rows[0], r)]
            i += 1
    while i < n:
        page, ln = stream[i]
        if not ln.strip():
            j = i
            while j < n and not stream[j][1].strip():
                j += 1
            if j >= n or looks_code(stream[j][1]) or is_bullet(stream[j][1]) \
                    or (HEADING_RE.match(stream[j][1]) and stream[j][1] == stream[j][1].lstrip()):
                break
            cj = cells_of(stream[j][1])
            if len(cj) < 2 and not (kv and cj and cj[0][1].endswith(":") and cj[0][0] <= starts[0] + 1):
                break
            if [t for _, t in cj] == header_cells:
                break
            i = j
            continue
        if looks_code(ln) or FIGURE_RE.match(ln) or TABLE_RE.match(ln):
            break
        cs = cells_of(ln)
        if HEADING_RE.match(ln) and ln == ln.lstrip():
            break
        if [t for _, t in cs] == header_cells:
            break
        if len(cs) >= 2:
            r = place(cs, page)
            if not kv and len(rows) > 1 and r[0] == "" and not any(rows[-1][k] == "" for k in (0,)):
                rows[-1] = [(a + " " + b).strip() for a, b in zip(rows[-1], r)]
            else:
                rows.append(r)
        elif kv and cs[0][1].endswith(":") and cs[0][0] <= starts[0] + 1:
            rows.append(place(cs, page))
        elif cs[0][0] > starts[0] + 1 and rows:
            # continuation of the previous row (wrapped cell)
            st = page_starts.get(page, starts)
            c = col_of(st, cs[0][0])
            if kv:
                while len(rows[-1]) < len(starts):
                    rows[-1].append("")
            rows[-1][c] = (rows[-1][c] + " " + cs[0][1]).strip()
        else:
            break
        i += 1
    for r in rows:
        while len(r) < len(starts):
            r.append("")
    widths = []
    for c, s in enumerate(starts):
        widths.append((starts[c + 1] - s) if c + 1 < len(starts) else 24)
    return {"type": "table", "header": not kv, "starts": starts,
            "widths": widths, "rows": rows}, i


def extract_images(pdf, build):
    imgdir = os.path.join(build, "images")
    if os.path.isdir(imgdir):
        shutil.rmtree(imgdir)
    os.makedirs(imgdir)
    listing = run(["pdfimages", "-list", pdf]).decode().split("\n")[2:]
    entries = []
    for l in listing:
        f = l.split()
        if len(f) > 3 and f[2] == "image":
            entries.append({"page": int(f[0]), "index": int(f[1]), "width": int(f[3]), "height": int(f[4])})
    run(["pdfimages", "-png", "-p", pdf, os.path.join(imgdir, "raw")])
    for e in entries:
        raw = os.path.join(imgdir, "raw-%03d-%03d.png" % (e["page"], e["index"]))
        e["raw"] = raw
    keep = {e["raw"] for e in entries}
    for f in sorted(os.listdir(imgdir)):
        if os.path.join(imgdir, f) not in keep:
            os.remove(os.path.join(imgdir, f))
    return entries


def attach_images(blocks, entries):
    """Figures take the first unused image on their page (else the previous page);
    the rest are placed after the last block of their page."""
    used = set()
    per_page = {}
    for e in entries:
        per_page.setdefault(e["page"], []).append(e)
    for b in blocks:
        if b["type"] != "figure":
            continue
        for pg in (b["page"], b["page"] - 1):
            free = [e for e in per_page.get(pg, []) if e["index"] not in used]
            if free:
                e = free[0]
                used.add(e["index"])
                b["image"] = "fig-%d.png" % b["number"]
                b["_src"] = os.path.basename(e["raw"])
                b["image_size"] = [e["width"], e["height"]]
                break
    cover = {1}
    rest = [e for e in entries if e["index"] not in used and e["page"] not in cover]
    rest.sort(key=lambda e: (e["page"], e["index"]))
    body_pages = [b["page"] for b in blocks]
    for e in rest:
        idxs = [k for k, p in enumerate(body_pages) if p <= e["page"]]
        pos = (idxs[-1] if idxs else -1) + 1
        samepage = [k for k, p in enumerate(body_pages) if p == e["page"]]
        if samepage:
            pos = samepage[-1] + 1
        blk = {"type": "image", "page": e["page"], "image": "p%02d-img%03d.png" % (e["page"], e["index"]),
               "_src": os.path.basename(e["raw"]), "image_size": [e["width"], e["height"]]}
        blocks.insert(pos, blk)
        body_pages.insert(pos, e["page"])
    return [e for e in entries if e["page"] in cover]


def main(argv):
    pdf = argv[1] if len(argv) > 1 else DEFAULT_PDF
    build = argv[2] if len(argv) > 2 else DEFAULT_BUILD
    if not os.path.isfile(pdf):
        raise SystemExit("extract-prose: no such PDF: %s" % pdf)
    os.makedirs(build, exist_ok=True)
    pages = read_pages(pdf)
    front = parse_front(pages)
    first = body_start(pages)
    blocks = parse_blocks(pages, first)
    entries = extract_images(pdf, build)
    cover_imgs = attach_images(blocks, entries)
    front["cover_images_not_used"] = len(cover_imgs)
    clauses = [{"number": b["number"], "level": b["level"], "title": b["title"], "page": b["page"]}
               for b in blocks if b["type"] == "heading"]
    stats = {"pdf_pages": len(pages),
             "clauses": len(clauses),
             "tables": sum(1 for b in blocks if b["type"] == "table"),
             "figures": sum(1 for b in blocks if b["type"] == "figure"),
             "unplaced_images": sum(1 for b in blocks if b["type"] == "image"),
             "code_blocks": sum(1 for b in blocks if b["type"] == "code"),
             "paragraphs": sum(1 for b in blocks if b["type"] == "paragraph")}
    doc = {"source": "reference-docs/" + os.path.basename(pdf),
           "front": front, "clauses": clauses, "blocks": blocks, "stats": stats}
    with open(os.path.join(build, "intermediate.json"), "w", encoding="utf-8") as f:
        json.dump(doc, f, ensure_ascii=False, indent=1, sort_keys=True)
        f.write("\n")
    print("extract-prose:", json.dumps(stats, sort_keys=True))


if __name__ == "__main__":
    main(sys.argv)
