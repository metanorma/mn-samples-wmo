#!/usr/bin/env python3
"""Assemble build/intermediate.json into sources/1.1.0/PS/ (Metanorma AsciiDoc).

Step 1 of metanorma/mn-samples-wmo#3 (pdf -> intermediate -> adoc).

    bin/assemble-ps [BUILD_DIR] [OUT_DIR]

Rewrites OUT_DIR/document.adoc, OUT_DIR/sections/ and OUT_DIR/images/ from
scratch on every run (idempotent, byte-stable, no timestamps). Anything
hand-edited in those paths is replaced: tailoring (#1) happens after the
last regeneration.
"""
import json
import os
import re
import shutil
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DEFAULT_BUILD = os.path.join(ROOT, "build")
DEFAULT_OUT = os.path.join(ROOT, "sources", "1.1.0", "PS")
MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August",
          "September", "October", "November", "December"]


def slug(text):
    s = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return s[:48].rstrip("-")


def provenance(src):
    return ("// Generated by bin/assemble-ps from %s (WMO S-411, 2014 edition)\n"
            "// via bin/extract-prose. Machine-populated draft (mn-samples-wmo#3): do not\n"
            "// edit by hand; rerunning the pipeline overwrites this file.\n" % src)


def esc_text(t):
    return t.replace("*", "\\*").replace("\n", " +\n")


def esc_cell(t):
    return t.replace("|", "\\|")


def render_table(b):
    out = []
    if b.get("title"):
        out.append(".%s" % b["title"])
    widths = [max(4, w) for w in b["widths"]]
    attrs = ["%header"] if b["header"] else []
    attrs.append('cols="%s"' % ",".join(str(w) for w in widths))
    out.append("[%s]" % ",".join(attrs))
    out.append("|===")
    for r in b["rows"]:
        out.append(" ".join("|" + esc_cell(c) if c else "|" for c in r))
    out.append("|===")
    return "\n".join(out)


def render_block(b):
    t = b["type"]
    if t == "paragraph":
        return esc_text(b["text"])
    if t == "list":
        return "\n".join("* " + esc_text(i) for i in b["items"])
    if t == "code":
        return "[source,%s]\n----\n%s\n----" % (b["lang"], "\n".join(b["lines"]))
    if t == "table":
        return render_table(b)
    if t == "figure":
        head = "[[figure-%d]]\n.%s\n" % (b["number"], b["caption"])
        if "image" in b:
            return head + "image::%s[%s]" % (b["image"], b["caption"])
        return head + "// no image extracted for this figure (PDF page %d)" % b["page"]
    if t == "image":
        return ("// PDF page %d: image not tied to a caption (portrayal symbol or similar)\n"
                "image::%s[]" % (b["page"], b["image"]))
    raise ValueError(t)


def render_heading(b):
    if "annex" in b:
        return "[[annex-%s]]\n[appendix]\n== %s" % (b["annex"], b["title"])
    ident = "clause-" + b["number"].replace(".", "-")
    return "[[%s]]\n%s %s" % (ident, "=" * (b["level"] + 1), b["title"])


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8", newline="\n") as f:
        f.write(text)


def main(argv):
    build = argv[1] if len(argv) > 1 else DEFAULT_BUILD
    out = argv[2] if len(argv) > 2 else DEFAULT_OUT
    with open(os.path.join(build, "intermediate.json"), encoding="utf-8") as f:
        doc = json.load(f)
    src = doc["source"]
    front = doc["front"]
    prov = provenance(src)

    for sub in ("sections", "images"):
        shutil.rmtree(os.path.join(out, sub), ignore_errors=True)
    os.makedirs(os.path.join(out, "images"))

    # split blocks into top-level clause groups
    groups = []
    for b in doc["blocks"]:
        if b["type"] == "heading" and b["level"] == 1:
            groups.append([b])
        elif groups:
            groups[-1].append(b)
        else:
            raise SystemExit("block before first clause: %r" % b)

    includes = []
    # version history (preface)
    vh = front.get("version_history")
    if vh:
        rows = [{"type": "table", "title": "Version history", "header": True,
                 "widths": [16, 12, 18, 40], "rows": [vh["header"]] + vh["rows"]}]
        text = prov + "\n[preface]\n== Version history\n\n" + render_table(rows[0]) + "\n"
        write(os.path.join(out, "sections", "00-version-history.adoc"), text)
        includes.append("sections/00-version-history.adoc")

    annex_n = 0
    copied = set()
    for g in groups:
        h = g[0]
        if "annex" in h:
            annex_n += 1
            name = "%d-annex-%s-%s" % (90 + annex_n, h["annex"].lower(), slug(h["title"]))
        else:
            name = "%02d-%s" % (int(h["number"]), slug(h["title"]))
        parts = []
        for b in g:
            if b["type"] == "heading":
                parts.append(render_heading(b))
            else:
                parts.append(render_block(b))
            if "_src" in b and b["image"] not in copied:
                shutil.copyfile(os.path.join(build, "images", b["_src"]),
                                os.path.join(out, "images", b["image"]))
                copied.add(b["image"])
        write(os.path.join(out, "sections", name + ".adoc"), prov + "\n" + "\n\n".join(parts) + "\n")
        includes.append("sections/%s.adoc" % name)

    month = MONTHS.index(front["month"]) + 1
    header = [
        "= %s" % front["title"],
        ":series: S",
        ":docnumber: %s" % front["designation"].split("-")[-1],
        ":doctype: specification",
        ":edition: %s" % front["edition"],
        ":language: en",
        ":published-date: %s-%02d" % (front["year"], month),
        ":copyright-year: %s" % front["year"],
        ":status: in-force",
        ":committee: %s" % front["committee"].lower(),
        ":mn-document-class: wmo",
        ":mn-output-extensions: xml,html,pdf",
        ":local-cache-only:",
        ":data-uri-image:",
        ":imagesdir: images",
    ]
    text = prov + "\n".join(header) + "\n\n" + "\n\n".join("include::%s[]" % i for i in includes) + "\n"
    write(os.path.join(out, "document.adoc"), text)
    print("assemble-ps: %d section files, %d images -> %s" % (len(includes), len(copied), out))


if __name__ == "__main__":
    main(sys.argv)
